# Applied by Cloudflare Workers Static Assets to files served from out/.
# (Not applied to worker/ responses, which set their own headers.)

# Build output with content hashes in the filenames never changes in place.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# JSON prebuilt from the route handlers in src/app/api. The export writes them
# without a file extension, so the type and caching they had as route handler
# responses are restored here.
/api/*
  Content-Type: application/json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Keep the *.workers.dev copies of the site out of search results.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
