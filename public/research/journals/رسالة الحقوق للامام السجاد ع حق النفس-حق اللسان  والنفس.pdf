     <rdf:li
      photoshop:LayerName="    Lorem ipsum dolor sit amet     Phasellus placerat urna et l"
      photoshop:LayerText="    Lorem ipsum dolor sit amet     Phasellus placerat urna et ligula auctor      Donec tincidunt auctor elit, at elementum      Curabitur pharetra ante ultricies      Donec nec neque et ipsum fermentum      Integer imperdiet nibh et lectus     Aliquam suscipit nulla in ante      Sed molestie magna      Fusce aliquet orci a tortor      "/>
     <rdf:li
      photoshop:LayerName="Pellentesque vehicula adipiscing faucibus.   Curabitur nec enim"
      photoshop:LayerText="Pellentesque vehicula adipiscing faucibus.   Curabitur nec enim ut libero dictum feugiat. Sed sagittis dui sit amet turpis pellentesque rutrum. Quisque ultrices ultricies magna, eu viverra tortor viverra eget. Vestibulum eu nunc id sem eleifend fringilla non nec enim. Duis sapien arcu, dapibus vel mattis nec, placerat ac nulla. In suscipit nibh in dui pulvinar scelerisque. In vitae iaculis eros. Quisque vitae risus ac libero tristique dapibus id tincidunt ligula. Quisque nec ultrices felis. Donec tortor ligula, tempus eu condimentum non, vulputate vel tellus. Fusce lectus lectus, rutrum id pharetra eu, pulvinar ut nibh. Cras dapibus, dui eu lacinia venenatis, nunc nulla ornare arcu, sed ullamcorper mi metus sit amet velit. Donec lacinia adipiscing euismod. Donec venenatis enim in sapien accumsan viverra. "/>
    </rdf:Bag>
   </photoshop:TextLayers>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

